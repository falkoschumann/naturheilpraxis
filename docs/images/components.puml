@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title "Component Diagram für Naturheilpraxis System"

Person(heilpraktiker, "Heilpraktiker", "Erfasst Patienten, stellt Diagnosen, erbringt Leistungen und rechnet ab.")
Person(patient, "Patient", "Erhält Rechnungen für die Krankenkasse oder das Finanzamt.")

System_Boundary(naturheilpraxis, "Naturheilpraxis System") {
  Container_Ext(electron, "Electron", "Electron, Node.js", "Container für die Web-Anwendung und Proxy für native Funktionen.")

  Container_Boundary(rendererProcess, "Renderer Process") {
    Component(ui, "UI", "React, Bootstrap", "Rendert die Benutzeroberfläche und sendet Commands und Queries per IPC.")
  }

  Container_Boundary(mainProcess, "Main Process") {
    Component(application, "Application", "TypeScript", "Führt Commands und Queries aus.")
    Component(infrastructure, "Infrastructure", "node:sqlite", "Liest und schreibt Events.")
  }

  Container_Boundary(shared, "Shared") {
    Component(domain, "Domain", "TypeScript", "Konsistenzgrenzen und Read Models, pure functional.")
  }

  ContainerDb(eventStore, "Event Store", "Sqlite", "Events aller Konsistenzgrenzen.")

  Rel(electron, ui, "Stelle UI bereit")
  Rel(electron, application, "Verwalte Lebenszyklus")
  ' In the left-to-right layout Rel_R stacks the elements vertically.
  Rel_R(ui, application, "")
  Rel(ui, domain, "Verwende Typen")
  Rel(application, domain, "Entscheide, projiziere")
  Rel_R(application, infrastructure, "Lade, speichere Events")
  Rel(infrastructure, eventStore, "Lies, schreibe Events", "SQL")
}

Rel(heilpraktiker, electron, "Bedient")
Rel(patient, electron, "Erhält Rechnung")

SHOW_FLOATING_LEGEND()
@enduml
