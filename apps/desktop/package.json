{
  "name": "@naturheilpraxis/desktop",
  "productName": "Naturheilpraxis",
  "version": "0.1.0",
  "description": "Leistungen für Patienten erfassen und in Rechnung stellen",
  "author": "Falko Schumann <falko.schumann@muspellheim.de>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "build/main/main.cjs",
  "scripts": {
    "dev": "bun --watch run scripts/dev.ts",
    "build": "vite build --app",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --fix",
    "check-types": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@naturheilpraxis/eslint-config": "*",
    "@naturheilpraxis/sheriff-config": "*",
    "@naturheilpraxis/stylelint-config": "*",
    "@naturheilpraxis/typescript-config": "*",
    "@naturheilpraxis/vitest-config": "*",
    "@playwright/test": "1.64.0",
    "@popperjs/core": "2.11.8",
    "@softarc/sheriff-core": "0.20.0",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bootstrap": "5.2.11",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bootstrap": "5.3.8",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sass": "1.105.1",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
