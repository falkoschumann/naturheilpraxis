{
  "name": "@naturheilpraxis/desktop",
  "productName": "Naturheilpraxis",
  "version": "0.1.0",
  "description": "Leistungen für Patienten erfassen und in Rechnung stellen",
  "author": "Falko Schumann <falko.schumann@muspellheim.de>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "build/main/main.cjs",
  "scripts": {
    "dev": "bun --watch run scripts/dev.ts",
    "build": "vite build --app",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --fix",
    "check-types": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@muspellheim/eslint-config": "0.3.2",
    "@muspellheim/sheriff-config": "0.3.2",
    "@muspellheim/stylelint-config": "0.3.2",
    "@muspellheim/typescript-config": "0.3.2",
    "@muspellheim/vitest-config": "0.3.2",
    "@playwright/test": "1.64.1",
    "@popperjs/core": "2.11.8",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@softarc/sheriff-core": "0.20.0",
    "@types/bootstrap": "5.2.11",
    "@types/mustache": "4.2.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bootstrap": "5.3.8",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "monocart-coverage-reports": "2.13.2",
    "mustache": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sass": "1.107.1",
    "stylelint": "17.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
