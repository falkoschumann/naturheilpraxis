{
  "name": "@naturheilpraxis/desktop",
  "productName": "Naturheilpraxis",
  "version": "0.1.0",
  "description": "Leistungen für Patienten erfassen und in Rechnung stellen",
  "author": "Falko Schumann <falko.schumann@muspellheim.de>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "build/main/main.cjs",
  "scripts": {
    "dev": "bun --watch run scripts/dev.ts",
    "build": "vite build --app",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "check-types": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@naturheilpraxis/eslint-config": "*",
    "@naturheilpraxis/sheriff-config": "*",
    "@naturheilpraxis/stylelint-config": "*",
    "@naturheilpraxis/typescript-config": "*",
    "@naturheilpraxis/vitest-config": "*",
    "@playwright/test": "^1.63.0",
    "@softarc/sheriff-core": "^0.19.6",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bootstrap": "^5.3.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "stylelint": "^17.15.0",
    "typescript": "^6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
